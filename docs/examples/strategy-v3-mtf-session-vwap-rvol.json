{
  "version": 3,
  "name": "5m Session VWAP + Daily EMA + RVOL",
  "market": "NASDAQ",
  "instrumentId": "NASDAQ:NVDA",
  "timeframe": "5m",
  "side": "LONG",
  "entry": {
    "type": "GROUP",
    "id": "multi-timeframe-entry",
    "operator": "AND",
    "children": [
      {
        "type": "CONDITION",
        "id": "daily-ema-trend",
        "left": {
          "type": "INDICATOR",
          "timeframe": "1d",
          "offset": 0,
          "kind": "EMA",
          "period": 20,
          "source": "close"
        },
        "operator": "GT",
        "right": {
          "type": "INDICATOR",
          "timeframe": "1d",
          "offset": 0,
          "kind": "EMA",
          "period": 60,
          "source": "close"
        }
      },
      {
        "type": "CONDITION",
        "id": "primary-vwap-cross",
        "left": {
          "type": "INDICATOR",
          "timeframe": "5m",
          "offset": 0,
          "kind": "PRICE",
          "field": "close"
        },
        "operator": "CROSS_ABOVE",
        "right": {
          "type": "INDICATOR",
          "timeframe": "5m",
          "offset": 0,
          "kind": "VWAP",
          "variant": { "kind": "SESSION" },
          "output": "VALUE"
        }
      }
    ]
  },
  "filters": {
    "type": "GROUP",
    "id": "relative-volume-filter",
    "operator": "AND",
    "children": [
      {
        "type": "CONDITION",
        "id": "relative-volume-ratio",
        "left": {
          "type": "INDICATOR",
          "timeframe": "5m",
          "offset": 0,
          "kind": "RELATIVE_VOLUME",
          "period": 20
        },
        "operator": "GT",
        "right": { "type": "CONSTANT", "value": 1.5 }
      }
    ]
  },
  "exits": [
    {
      "kind": "ATR_STOP",
      "id": "atr-stop",
      "priority": 10,
      "period": 14,
      "multiplier": 2,
      "quantityPercent": 100
    },
    {
      "kind": "ATR_TRAILING",
      "id": "atr-trailing",
      "priority": 40,
      "period": 14,
      "multiplier": 2,
      "quantityPercent": 100
    }
  ],
  "positionSizing": { "kind": "EQUITY_PERCENT", "value": 100 },
  "risk": {
    "maximumPositions": 1,
    "maximumSymbolAllocationPercent": 100,
    "maximumDailyLossPercent": 5,
    "maximumStrategyDrawdownPercent": 30,
    "maximumPortfolioDrawdownPercent": 30,
    "consecutiveLossLimit": 8
  },
  "execution": {
    "signalAt": "BAR_CLOSE",
    "fillAt": "NEXT_BAR_OPEN",
    "order": { "type": "MARKET" },
    "intrabarPolicy": "CONSERVATIVE",
    "commissionBps": 1.5,
    "slippageBps": 5,
    "spreadBps": 2,
    "minimumTick": 0.01,
    "startingCapital": 100000
  },
  "overlays": []
}
