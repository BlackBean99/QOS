{
  "name": "qos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm audit --omit=dev",
    "deploy:local": "npm run deploy:local:stop && npm run build && tsx scripts/local-deploy.ts deploy",
    "deploy:local:status": "tsx scripts/local-deploy.ts status",
    "deploy:local:stop": "tsx scripts/local-deploy.ts stop",
    "release:local": "npm run deploy:local:stop && npm run verify && npm run test:e2e && tsx scripts/local-deploy.ts deploy",
    "monitor": "tsx scripts/live-monitor.ts",
    "db:link": "supabase link",
    "db:push": "supabase db push --linked",
    "db:migrations": "supabase migration list --linked",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ixjb94/indicators": "1.2.6",
    "@next/env": "16.3.5",
    "klinecharts": "10.0.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
