# Leave blank for the default local reference compiler: no OpenAI API call or charge.
# A Codex/ChatGPT sign-in cannot be reused by this app as an API credential.
# Explicit opt-in only: setting a key enables separately billed server-side API calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only strategy CRUD and backtest history persistence. Do not expose the secret key
# through NEXT_PUBLIC_* or commit it. Legacy projects may use SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for actual domestic/US stock master, candles and real-time trades.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Required for BUY/SELL delivery. Connect the private chat from the app after setup.
TELEGRAM_BOT_TOKEN=
